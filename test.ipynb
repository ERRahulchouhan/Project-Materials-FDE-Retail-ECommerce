   "source": [
    "def my(s):\n",
    "    maxlength = \"\"\n",
    "    for i in range(len(s)):\n",
    "\n",
    "        for j in range(i, len(s)):\n",
    "            v = s[i:j+1]\n",
    "\n",
    "            if v == v[::-1] and len(v) >= len(maxlength):\n",
    "                maxlength = v\n",
    "    return maxlength\n",
    "\n",
    "input = \"abaaa\"\n",
    "my(input)\n",
    "\n"
   ]
  },
